# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_token_bot

# Application (client) ID of your bot
CLIENT_ID=your_client_id_bot

# Discord user ID of the bot owner (used for /eval and owner-only guards)
OWNER_ID=your_user_id_here

# 'json' or 'sqlite'
DB_TYPE=sqlite

# Path to the SQLite database file (only used when DB_TYPE=sqlite)
DB_PATH=./data/mochi.db

# Path to the JSON database file (only used when DB_TYPE=json)
DB_JSON_PATH=./data/database.json

# Get from browser: Login to IG > DevTools > Application > Cookies
# sessionid = required (for posts, reels, story photos)
# ig_did, mid, ds_user_id = required for story videos
IG_SESSION_ID=
IG_DS_USER_ID=
IG_MID=
IG_DID=
